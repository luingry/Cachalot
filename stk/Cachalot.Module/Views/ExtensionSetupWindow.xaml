<Window x:Class="Cachalot.Module.Views.ExtensionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk"
        Title="Extensão do Cachalot para o Chrome"
        Width="572" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.FontFamily="{StaticResource Font.Text}" TextElement.Foreground="{StaticResource Brush.Text.Primary}"
        UseLayoutRounding="True" ShowInTaskbar="True">
    <!-- Offered once after the module is installed, and from Configurações → "Instalar no Chrome…". -->
    <Window.Resources>
        <Style x:Key="StepHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}" />
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,14,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface4}" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StepRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="24" Background="{StaticResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Xl}"
            Effect="{StaticResource Elevation.Overlay}" MouseLeftButtonDown="OnDrag">
        <StackPanel Margin="28,26,28,24">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Brush.Surface3}" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="Logo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="LogoGlyph" Text="&#xEA86;" Style="{StaticResource Text.Icon}" FontSize="24" Foreground="{StaticResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Instalar a extensão do Chrome?" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Um clique no Chrome manda o vídeo, o áudio ou a página para o Cachalot, com o login do site."
                               Style="{StaticResource Text.Paragraph}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Icon.Sm}" ui:Ui.Icon="&#xE711;" ToolTip="Fechar (Esc)"
                        VerticalAlignment="Top" Margin="0,-10,-10,0" Click="OnClose" />
            </Grid>

            <!-- Status -->
            <Border x:Name="StatusBox" Margin="0,20,0,0" Padding="14,10" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Brush.Info.Soft}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusIcon" Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{StaticResource Brush.Info}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Steps -->
            <StackPanel x:Name="Steps" Margin="0,6,0,0">
                <Grid Style="{StaticResource StepRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CopyBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="CopyBadgeText" Text="1" Style="{StaticResource BadgeText}" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Copiar a extensão para uma pasta fixa" Style="{StaticResource StepTitle}" />
                        <TextBlock x:Name="CopyHint" Style="{StaticResource StepHint}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource StepRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DevBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="DevBadgeText" Text="2" Style="{StaticResource BadgeText}" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Ligar o Modo do desenvolvedor" Style="{StaticResource StepTitle}" />
                        <TextBlock x:Name="DevHint" Style="{StaticResource StepHint}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource StepRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LoadBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="LoadBadgeText" Text="3" Style="{StaticResource BadgeText}" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Carregar a extensão" Style="{StaticResource StepTitle}" />
                        <TextBlock x:Name="LoadHint" Style="{StaticResource StepHint}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource StepRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PairBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="PairBadgeText" Text="4" Style="{StaticResource BadgeText}" /></Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Parear com este PC" Style="{StaticResource StepTitle}" />
                        <TextBlock x:Name="PairHint" Style="{StaticResource StepHint}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyPathButton" Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8C8;" Content="Copiar o caminho"
                        Click="OnCopyPath" Visibility="Collapsed" />
                <Button x:Name="SecondaryButton" Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Agora não" Click="OnClose" Margin="0,0,8,0" />
                <Button x:Name="PrimaryButton" Grid.Column="3" Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE896;" Content="Instalar" Click="OnPrimary" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
